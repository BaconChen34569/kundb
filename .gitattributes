# 统一行尾，避免 Windows / Linux 检出差异造成整个文件被标为改动
* text=auto

*.java   text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.py     text eol=lf
*.sql    text eol=lf
*.cmake  text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf
*.vbs    text eol=crlf

*.png binary
*.ico binary
*.bmp binary
*.jpg binary
*.rtf binary
